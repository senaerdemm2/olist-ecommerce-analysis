-- ============================================================
-- BONUS 0A: Global KPIs (Page 2 — 4 KPI Cards)
-- Output: global_kpis.csv
-- ============================================================
-- Purpose: Calculates the headline KPI values shown on Page 2.
--          Filters out canceled orders since they are not realized revenue.
--          Cancellation rate is excluded here — see Bonus 0B for the fix.
-- ============================================================
SELECT
    COUNT(DISTINCT o.order_id) AS total_orders,
    ROUND(SUM(oi.price + oi.freight_value)::numeric, 2) AS total_revenue,
    ROUND((SUM(oi.price + oi.freight_value) / COUNT(DISTINCT o.order_id))::numeric, 2) AS avg_order_value,
    ROUND(AVG(EXTRACT(EPOCH FROM (o.order_delivered_customer_date - o.order_purchase_timestamp)) / 86400)::numeric, 2) AS avg_delivery_time_days
FROM orders o
JOIN order_items oi ON o.order_id = oi.order_id
WHERE o.order_status != 'canceled'
  AND o.order_purchase_timestamp IS NOT NULL;


-- ============================================================
-- BONUS 0B: Cancellation Rate (Data Accuracy Fix)
-- Output: cancellation_rate.csv
-- ============================================================
-- Purpose: Calculates the true cancellation rate across ALL orders.
--
-- WHY THIS IS A SEPARATE QUERY:
--   The Global KPIs query above uses "WHERE order_status != 'canceled'"
--   to compute revenue from realized orders only. If we tried to compute
--   the cancellation rate inside that same query, the WHERE clause would
--   filter out canceled orders BEFORE the COUNT(CASE WHEN...) ran —
--   resulting in a 0% cancellation rate (which is wrong).
--
--   Data accuracy > convenience. Each KPI gets the filter it needs.
-- ============================================================
SELECT
    COUNT(DISTINCT o.order_id) AS total_orders_all,
    COUNT(DISTINCT CASE WHEN o.order_status = 'canceled' THEN o.order_id END) AS canceled_orders,
    ROUND(
        COUNT(DISTINCT CASE WHEN o.order_status = 'canceled' THEN o.order_id END)::numeric /
        COUNT(DISTINCT o.order_id)::numeric * 100,
        2
    ) AS cancellation_rate_pct
FROM orders o
WHERE o.order_purchase_timestamp IS NOT NULL;


-- ============================================================
-- QUESTION 1: Monthly Revenue Trend
-- Output: monthly_revenue.csv (Page 1 — Line Chart)
-- ============================================================
-- Purpose: Track monthly revenue, order volume, and unique customers
--          to identify growth trends across 2016-2018.
-- ============================================================
SELECT
    DATE_TRUNC('month', o.order_purchase_timestamp) AS month,
    SUM(oi.price + oi.freight_value) AS total_revenue,
    COUNT(DISTINCT o.order_id) AS order_count,
    COUNT(DISTINCT c.customer_unique_id) AS unique_customers
FROM orders o
INNER JOIN order_items oi ON o.order_id = oi.order_id
INNER JOIN customers c    ON o.customer_id = c.customer_id
WHERE o.order_status = 'delivered'
GROUP BY DATE_TRUNC('month', o.order_purchase_timestamp)
ORDER BY month;


-- ============================================================
-- QUESTION 2A: Top 10 Product Categories by REVENUE
-- Output: soru2a_top_categories_revenue.csv (Page 2 — Bar Chart, Revenue mode)
-- ============================================================
-- Purpose: Identify the highest-grossing product categories.
--          Uses COALESCE to prefer English category names over Portuguese.
-- ============================================================
SELECT
    COALESCE(t.product_category_name_english, p.product_category_name) AS category_name,
    COUNT(oi.order_item_id) AS order_count,
    ROUND(SUM(oi.price + oi.freight_value)::numeric, 2) AS total_revenue
FROM orders o
INNER JOIN order_items oi ON o.order_id = oi.order_id
INNER JOIN products p     ON oi.product_id = p.product_id
LEFT JOIN product_category_name_translation t
    ON p.product_category_name = t.product_category_name
WHERE o.order_status = 'delivered'
GROUP BY COALESCE(t.product_category_name_english, p.product_category_name)
ORDER BY total_revenue DESC
LIMIT 10;


-- ============================================================
-- QUESTION 2B: Top 10 Product Categories by ORDERS
-- Output: soru2b_top_categories_orders.csv (Page 2 — Bar Chart, Orders mode)
-- ============================================================
-- Purpose: Identify the most-ordered product categories by volume.
--          Paired with Question 2A via a slicer in Power BI.
-- ============================================================
SELECT
    COALESCE(t.product_category_name_english, p.product_category_name) AS category_name,
    COUNT(oi.order_item_id) AS order_count,
    ROUND(SUM(oi.price + oi.freight_value)::numeric, 2) AS total_revenue
FROM orders o
INNER JOIN order_items oi ON o.order_id = oi.order_id
INNER JOIN products p     ON oi.product_id = p.product_id
LEFT JOIN product_category_name_translation t
    ON p.product_category_name = t.product_category_name
WHERE o.order_status = 'delivered'
GROUP BY COALESCE(t.product_category_name_english, p.product_category_name)
ORDER BY order_count DESC
LIMIT 10;


-- ============================================================
-- QUESTION 3: Customer Segmentation by Total Spending
-- Output: customer_segments.csv (Page 1 — Bar Chart)
-- ============================================================
-- Purpose: Segment customers into Low / Regular / Premium tiers
--          based on their lifetime spending.
--          Premium: >1000 BRL | Regular: 500-1000 BRL | Low: <500 BRL
-- ============================================================
SELECT
    c.customer_unique_id,
    c.customer_state,
    SUM(oi.price + oi.freight_value) AS total_spending,
    CASE
        WHEN SUM(oi.price + oi.freight_value) > 1000                THEN 'Premium'
        WHEN SUM(oi.price + oi.freight_value) BETWEEN 500 AND 1000  THEN 'Regular'
        ELSE 'Low'
    END AS segment
FROM customers c
INNER JOIN orders o      ON c.customer_id = o.customer_id
INNER JOIN order_items oi ON o.order_id = oi.order_id
WHERE o.order_status = 'delivered'
GROUP BY c.customer_unique_id, c.customer_state;


-- ============================================================
-- QUESTION 4: Average Order Value (AOV) by Category
-- Output: aov_by_category.csv (Page 2 — Bonus Chart)
-- ============================================================
-- Purpose: Identify categories with the highest average order value.
--          Useful for spotting premium product niches.
-- ============================================================
SELECT
    COALESCE(t.product_category_name_english, p.product_category_name) AS category_name,
    ROUND(AVG(oi.price + oi.freight_value)::numeric, 2) AS average_order_value,
    COUNT(oi.order_item_id) AS order_count
FROM orders o
INNER JOIN order_items oi ON o.order_id = oi.order_id
INNER JOIN products p     ON oi.product_id = p.product_id
LEFT JOIN product_category_name_translation t
    ON p.product_category_name = t.product_category_name
WHERE o.order_status = 'delivered'
GROUP BY COALESCE(t.product_category_name_english, p.product_category_name)
ORDER BY average_order_value DESC;


-- ============================================================
-- QUESTION 5: Repeat Customer Analysis (Bonus)
-- Output: repeat_customers.csv (Page 1 — KPI Card)
-- ============================================================
-- Purpose: Calculate the repeat-customer rate and the revenue share
--          contributed by repeat customers.
--          Uses a CTE to first aggregate per-customer stats.
-- ============================================================
WITH customer_summary AS (
    SELECT
        c.customer_unique_id,
        COUNT(DISTINCT o.order_id) AS order_count,
        SUM(oi.price + oi.freight_value) AS total_spending
    FROM customers c
    INNER JOIN orders o      ON c.customer_id = o.customer_id
    INNER JOIN order_items oi ON o.order_id = oi.order_id
    WHERE o.order_status = 'delivered'
    GROUP BY c.customer_unique_id
)
SELECT
    COUNT(*) AS repeat_customers,
    (SELECT COUNT(*) FROM customer_summary) AS total_customers,
    ROUND(100.0 * COUNT(*) / (SELECT COUNT(*) FROM customer_summary), 2) AS repeat_customer_rate_pct,
    SUM(total_spending) AS repeat_customer_revenue,
    (SELECT SUM(total_spending) FROM customer_summary) AS total_revenue,
    ROUND(100.0 * SUM(total_spending) / (SELECT SUM(total_spending) FROM customer_summary), 2) AS revenue_contribution_pct
FROM customer_summary
WHERE order_count > 1;


-- ============================================================
-- QUESTION 6: Top 10 States by Revenue
-- Output: top_states.csv (Page 1 — Bar Chart, base version)
-- ============================================================
-- Purpose: Rank Brazilian states by total revenue.
--          Base version — for the bar chart X-axis.
-- ============================================================
SELECT
    c.customer_state,
    COUNT(DISTINCT c.customer_unique_id) AS unique_customer_count,
    COUNT(DISTINCT o.order_id)           AS order_count,
    SUM(oi.price + oi.freight_value)     AS total_revenue,
    ROUND(AVG(oi.price + oi.freight_value), 2) AS avg_order_value
FROM customers c
INNER JOIN orders o      ON c.customer_id = o.customer_id
INNER JOIN order_items oi ON o.order_id = oi.order_id
WHERE o.order_status = 'delivered'
GROUP BY c.customer_state
ORDER BY total_revenue DESC
LIMIT 10;


-- ============================================================
-- BONUS: Top States Enhanced (Enriched Tooltips)
-- Output: top_states_enhanced.csv (Page 1 — Tooltips)
-- ============================================================
-- Purpose: Provide multi-metric context for the Top 10 States chart.
--          When a user hovers over a state, the tooltip shows:
--          revenue + orders + avg delivery + avg order value.
--
--          Design principle (Microsoft/Amazon): one metric is half-analysis.
--          Always give context so executives can decide in one glance.
-- ============================================================
SELECT
    c.customer_state,
    ROUND(SUM(oi.price + oi.freight_value)::numeric, 2) AS total_revenue,
    COUNT(DISTINCT o.order_id) AS total_orders,
    ROUND(AVG(EXTRACT(EPOCH FROM (o.order_delivered_customer_date - o.order_purchase_timestamp)) / 86400)::numeric, 2) AS avg_delivery_days,
    ROUND((SUM(oi.price + oi.freight_value) / COUNT(DISTINCT o.order_id))::numeric, 2) AS avg_order_value
FROM customers c
INNER JOIN orders o      ON c.customer_id = o.customer_id
INNER JOIN order_items oi ON o.order_id = oi.order_id
WHERE o.order_status = 'delivered'
GROUP BY c.customer_state
ORDER BY total_revenue DESC
LIMIT 10;


-- ============================================================
-- QUESTION 7: Average Delivery Time by Category
-- Output: delivery_by_category.csv (Page 2 — Chart 3)
-- ============================================================
-- Purpose: Identify categories with the longest delivery times.
--          Uses EXTRACT(EPOCH) to convert interval to days.
-- ============================================================
SELECT
    COALESCE(t.product_category_name_english, p.product_category_name) AS category_name,
    ROUND(AVG(EXTRACT(EPOCH FROM (o.order_delivered_customer_date - o.order_purchase_timestamp)) / 86400)::numeric, 2) AS avg_delivery_days,
    COUNT(DISTINCT o.order_id) AS order_count
FROM orders o
INNER JOIN order_items oi ON o.order_id = oi.order_id
INNER JOIN products p     ON oi.product_id = p.product_id
LEFT JOIN product_category_name_translation t
    ON p.product_category_name = t.product_category_name
WHERE o.order_status = 'delivered'
  AND o.order_delivered_customer_date IS NOT NULL
  AND o.order_purchase_timestamp IS NOT NULL
GROUP BY COALESCE(t.product_category_name_english, p.product_category_name)
ORDER BY avg_delivery_days DESC;


-- ============================================================
-- QUESTION 8: Cancellation Rate by Category
-- Output: cancellation_by_category.csv (Page 2 — Bonus Chart)
-- ============================================================
-- Purpose: Identify product categories with the highest cancellation rates.
--          Uses HAVING COUNT(*) > 10 to filter out low-volume noise.
-- ============================================================
SELECT
    COALESCE(t.product_category_name_english, p.product_category_name) AS category_name,
    COUNT(*) AS total_orders,
    COUNT(CASE WHEN o.order_status IN ('canceled', 'unavailable') THEN 1 END) AS cancelled_orders,
    ROUND(
        COUNT(CASE WHEN o.order_status IN ('canceled', 'unavailable') THEN 1 END) * 100.0 / COUNT(*),
        2
    ) AS cancellation_rate_pct
FROM orders o
INNER JOIN order_items oi ON o.order_id = oi.order_id
INNER JOIN products p     ON oi.product_id = p.product_id
LEFT JOIN product_category_name_translation t
    ON p.product_category_name = t.product_category_name
GROUP BY COALESCE(t.product_category_name_english, p.product_category_name)
HAVING COUNT(*) > 10
ORDER BY cancellation_rate_pct DESC
LIMIT 10;


-- ============================================================
-- QUESTION 9: Top 10 Sellers by Revenue
-- Output: top_sellers.csv (Page 2 — Bonus Chart)
-- ============================================================
-- Purpose: Identify the highest-grossing sellers and their main category.
-- ============================================================
SELECT
    oi.seller_id,
    COALESCE(t.product_category_name_english, p.product_category_name) AS category_name,
    ROUND(SUM(oi.price + oi.freight_value)::numeric, 2) AS total_revenue,
    COUNT(*) AS order_count
FROM orders o
INNER JOIN order_items oi ON o.order_id = oi.order_id
INNER JOIN products p     ON oi.product_id = p.product_id
LEFT JOIN product_category_name_translation t
    ON p.product_category_name = t.product_category_name
WHERE o.order_status = 'delivered'
GROUP BY oi.seller_id, COALESCE(t.product_category_name_english, p.product_category_name)
ORDER BY total_revenue DESC
LIMIT 10;


-- ============================================================
-- QUESTION 10: Weekend vs Weekday Sales Comparison
-- Output: weekend_vs_weekday.csv (Page 2 — Chart 4)
-- ============================================================
-- Purpose: Compare order volume, revenue, and AOV between weekdays and weekends.
--          Uses a CTE to first classify each order by day type.
--          EXTRACT(DOW FROM ...) returns 0 (Sunday) and 6 (Saturday) as weekend.
-- ============================================================
WITH classified_orders AS (
    SELECT
        o.order_id,
        oi.price + oi.freight_value AS order_value,
        CASE
            WHEN EXTRACT(DOW FROM o.order_purchase_timestamp) IN (0, 6) THEN 'Weekend'
            ELSE 'Weekday'
        END AS day_type
    FROM orders o
    INNER JOIN order_items oi ON o.order_id = oi.order_id
    WHERE o.order_status = 'delivered'
)
SELECT
    day_type,
    COUNT(DISTINCT order_id) AS order_count,
    ROUND(SUM(order_value)::numeric, 2) AS total_revenue,
    ROUND(AVG(order_value)::numeric, 2) AS avg_order_value
FROM classified_orders
GROUP BY day_type
ORDER BY total_revenue DESC;

